{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/VictorCao945/ai-creator-index/schemas/creator-index.schema.json",
  "title": "AI Creator Index",
  "type": "object",
  "required": ["meta", "creators", "posts", "rankings", "sources", "mentions"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["schema_version", "data_version", "snapshot_date", "methodology", "evidence_rules"],
      "properties": {
        "schema_version": {"type": "string"},
        "data_version": {"type": "string"},
        "generated_for": {"type": "string"},
        "snapshot_date": {"$ref": "#/$defs/date"},
        "methodology": {"type": "object"},
        "evidence_rules": {
          "type": "object",
          "required": ["A", "B", "C"],
          "additionalProperties": false,
          "properties": {
            "A": {"type": "string"},
            "B": {"type": "string"},
            "C": {"type": "string"}
          }
        }
      }
    },
    "creators": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/creator"}
    },
    "posts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/post"}
    },
    "rankings": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["label", "post_ids"],
        "properties": {
          "label": {"type": "string"},
          "post_ids": {
            "type": "array",
            "items": {"$ref": "#/$defs/id"}
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source"}
    },
    "mentions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/mention"}
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "nullableUrl": {
      "oneOf": [
        {"type": "string", "format": "uri"},
        {"type": "null"}
      ]
    },
    "creator": {
      "type": "object",
      "required": [
        "id", "display_name", "bio", "profile_summary", "media", "topics",
        "platform_accounts", "stats_snapshot", "editorial_takeaways",
        "content_analysis", "last_verified_at"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "display_name": {"type": "string", "minLength": 1},
        "aliases": {"type": "array", "items": {"type": "string"}},
        "bio": {"type": "string"},
        "profile_summary": {"type": "string"},
        "media": {
          "type": "object",
          "required": ["avatar_path", "profile_screenshot_path", "captured_at"],
          "additionalProperties": false,
          "properties": {
            "avatar_path": {"type": "string", "minLength": 1},
            "profile_screenshot_path": {"type": "string", "minLength": 1},
            "captured_at": {"$ref": "#/$defs/date"}
          }
        },
        "topics": {"type": "array", "items": {"type": "string"}},
        "platform_accounts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["platform", "handle", "platform_id", "profile_url", "verified_at"],
            "properties": {
              "platform": {"type": "string"},
              "handle": {"type": "string"},
              "platform_id": {"type": "string"},
              "profile_url": {"type": "string", "format": "uri"},
              "canonical_profile_url": {"type": "string", "format": "uri"},
              "verified_at": {"$ref": "#/$defs/date"}
            }
          }
        },
        "stats_snapshot": {
          "type": "object",
          "required": ["captured_at", "public_post_count", "recent_window_days", "recent_post_count"],
          "properties": {
            "captured_at": {"$ref": "#/$defs/date"},
            "public_post_count": {"type": "integer", "minimum": 0},
            "earliest_public_post": {"$ref": "#/$defs/date"},
            "latest_public_post": {"$ref": "#/$defs/date"},
            "recent_window_days": {"type": "integer", "minimum": 1},
            "recent_post_count": {"type": "integer", "minimum": 0},
            "profile_social_proof": {"type": "string"}
          }
        },
        "editorial_takeaways": {"type": "array", "items": {"type": "string"}},
        "content_analysis": {
          "type": "object",
          "required": ["positioning", "content_loop", "reader_value", "source_channels"],
          "additionalProperties": false,
          "properties": {
            "positioning": {"type": "string"},
            "content_loop": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["label", "explanation", "examples"],
                "additionalProperties": false,
                "properties": {
                  "label": {"type": "string"},
                  "explanation": {"type": "string"},
                  "examples": {"type": "array", "items": {"type": "string"}}
                }
              }
            },
            "reader_value": {"type": "array", "items": {"type": "string"}},
            "source_channels": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["channel", "examples"],
                "additionalProperties": false,
                "properties": {
                  "channel": {"type": "string"},
                  "examples": {"type": "array", "items": {"type": "string"}}
                }
              }
            }
          }
        },
        "last_verified_at": {"$ref": "#/$defs/date"}
      }
    },
    "metrics": {
      "type": "object",
      "required": ["captured_at", "likes"],
      "properties": {
        "captured_at": {"$ref": "#/$defs/date"},
        "likes": {"type": "integer", "minimum": 0},
        "saves": {"type": "integer", "minimum": 0},
        "comments": {"type": "integer", "minimum": 0},
        "shares": {"type": "integer", "minimum": 0},
        "approximate": {"type": "boolean"}
      }
    },
    "post": {
      "type": "object",
      "required": [
        "id", "creator_id", "platform", "original_id", "original_url", "title",
        "format", "published_at", "metrics", "topics", "selection_reason", "focus"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "creator_id": {"$ref": "#/$defs/id"},
        "platform": {"type": "string"},
        "original_id": {"type": ["string", "null"]},
        "original_url": {"$ref": "#/$defs/nullableUrl"},
        "title": {"type": "string", "minLength": 1},
        "format": {"enum": ["image_text", "video", "text", "audio", "unknown"]},
        "published_at": {"$ref": "#/$defs/date"},
        "metrics": {"$ref": "#/$defs/metrics"},
        "topics": {"type": "array", "items": {"type": "string"}},
        "selection_reason": {"type": "string"},
        "focus": {"type": "boolean"}
      }
    },
    "source": {
      "type": "object",
      "required": [
        "id", "title", "url", "source_type", "evidence_grade",
        "verification_status", "verified_at", "note"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "title": {"type": "string"},
        "url": {"$ref": "#/$defs/nullableUrl"},
        "source_type": {"type": "string"},
        "evidence_grade": {"enum": ["A", "B", "C"]},
        "verification_status": {"enum": ["已验证", "部分验证", "未解决"]},
        "verified_at": {"$ref": "#/$defs/date"},
        "note": {"type": "string"}
      }
    },
    "mention": {
      "type": "object",
      "required": ["id", "name", "type", "summary", "topics", "post_ids", "source_ids"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "name": {"type": "string"},
        "type": {
          "enum": [
            "product", "podcast", "article", "person", "paper", "event",
            "open_source", "prompt", "workflow", "platform"
          ]
        },
        "summary": {"type": "string"},
        "topics": {"type": "array", "items": {"type": "string"}},
        "post_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/id"}
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/id"}
        }
      }
    }
  }
}
